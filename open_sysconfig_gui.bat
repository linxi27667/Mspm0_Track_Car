@echo off
setlocal
rem Generated by repair_sysconfig.py. Paths with spaces are supported.
set "SYSCONFIG_DIR=E:\MCU\MSPM0\sysconfig"
set "SDK_ROOT=E:\MCU\MSPM0\m0_sdk\mspm0_sdk_1_30_00_03"
set "SYSCFG_FILE=%~dp0TI_moban.syscfg"

if not exist "%SYSCONFIG_DIR%\nw\nw.exe" (
    echo [ERROR] SysConfig GUI not found: %SYSCONFIG_DIR%
    pause
    exit /b 2
)
if not exist "%SYSCFG_FILE%" (
    echo [ERROR] Config not found: %SYSCFG_FILE%
    pause
    exit /b 3
)

rem Let the fixed .syscfg path supply its complete embedded @cliArgs.
start "" "%SYSCONFIG_DIR%\nw\nw.exe" "%SYSCONFIG_DIR%" --compiler keil -s "%SDK_ROOT%\.metadata\product.json" "%SYSCFG_FILE%"
endlocal
